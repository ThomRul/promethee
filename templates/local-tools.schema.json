{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Commandes locales des outils Prométhée",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tools"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "executablePath",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "executablePath": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
